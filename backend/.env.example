# =============================================================================
# ApplyPilot AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=ApplyPilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-characters
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default for local development)
DATABASE_URL=sqlite+aiosqlite:///./applypilot.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/applypilot

# -----------------------------------------------------------------------------
# AI Providers (add keys for providers you want to use)
# -----------------------------------------------------------------------------
# Google Gemini (Primary - Free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Optional fallback - Free tier available)
# GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (Optional fallback)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# Gmail OAuth (Required for email sending)
# -----------------------------------------------------------------------------
# Get these from Google Cloud Console:
# 1. Enable Gmail API
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Set redirect URI to: http://localhost:8000/api/gmail/callback
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
DAILY_EMAIL_LIMIT=50
EMAIL_SEND_DELAY_SECONDS=30
JOB_DISCOVERY_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
